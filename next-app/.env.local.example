# ============================================================
# LitRev — Environment Configuration
# ============================================================
# Copy to .env.local and fill in your values.
#
# Workflow:
#   Local dev  → local Postgres (DATABASE_URL points to localhost)
#   Deploy     → Supabase Postgres (env vars set in Vercel dashboard)
#
# Prisma CLI reads .env.local but does NOT override env vars
# already set in the shell, so you can do one-off commands
# against Supabase by prefixing:
#   DATABASE_URL="postgres://..." npx prisma migrate deploy
# ============================================================

# --- Database (REQUIRED) ---
# Local Postgres for development
DATABASE_URL="postgresql://youruser@localhost:5432/litrev_dev"
DIRECT_URL="postgresql://youruser@localhost:5432/litrev_dev"

# --- OpenAI (REQUIRED for AI features) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Authentication (REQUIRED for auth-enabled environments) ---
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM="LitRev <onboarding@resend.dev>"
# Preview/dev quick access button on /login.
# Server-side guard also requires non-production runtime OR VERCEL_ENV=preview.
ENABLE_DEV_QUICK_LOGIN=0
NEXT_PUBLIC_ENABLE_DEV_QUICK_LOGIN=0

# --- Supabase Storage (REQUIRED for PDF uploads) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Additional AI Providers (OPTIONAL) ---
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- AI Configuration (OPTIONAL — defaults shown) ---
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5.2
AI_REASONING_MODEL=gpt-5.2
AI_RATE_LIMIT=20
AI_DAILY_TOKEN_LIMIT=100000

# --- Agentic Modes (OPTIONAL) ---
# Scoping mode controls pre-protocol literature landscape exploration.
# Default behavior if unset: ENABLED.
# Set both flags to "0" to force-disable across client + server.
NEXT_PUBLIC_ENABLE_SCOPING_MODE=1
ENABLE_SCOPING_MODE=1

# Scoping decision card v2 controls the decision-first scoping artifact UI.
# Default behavior if unset: ENABLED.
NEXT_PUBLIC_SCOPING_DECISION_CARD_V2=1

# Chat study mentions v1 controls inline "Mentioned studies" chips and one-click add-to-ledger.
# Default behavior if unset: ENABLED.
NEXT_PUBLIC_CHAT_STUDY_MENTIONS_V1=1

# --- Langfuse Observability (OPTIONAL) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com
