# ============================================================
# LitRev — Environment Configuration
# ============================================================
# Copy to .env.local and fill in your values.
#
# Workflow:
#   Local dev  → local Postgres (DATABASE_URL points to localhost)
#   Deploy     → Supabase Postgres (env vars set in Vercel dashboard)
#
# Prisma CLI reads .env.local but does NOT override env vars
# already set in the shell, so you can do one-off commands
# against Supabase by prefixing:
#   DATABASE_URL="postgres://..." npx prisma migrate deploy
# ============================================================

# --- Database (REQUIRED) ---
# Local Postgres for development
DATABASE_URL="postgresql://youruser@localhost:5432/litrev_dev"
DIRECT_URL="postgresql://youruser@localhost:5432/litrev_dev"

# --- OpenAI (REQUIRED for AI features) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Authentication (REQUIRED for auth-enabled environments) ---
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM="LitRev <onboarding@resend.dev>"
# Preview quick access button on /login (production runtime only).
# Local/dev runtime allows quick access without flags.
# For Vercel preview, set both to 1.
ENABLE_DEV_QUICK_LOGIN=0
NEXT_PUBLIC_ENABLE_DEV_QUICK_LOGIN=0

# --- Supabase Storage (REQUIRED for PDF uploads) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STUDY_PROCESSING_INTERNAL_TOKEN=replace-with-a-long-random-token

# --- GROBID (OPTIONAL for improved PDF metadata extraction) ---
# Example: http://localhost:8070
GROBID_URL=
# Request timeout for GROBID calls (milliseconds)
GROBID_TIMEOUT_MS=15000

# --- Additional AI Providers (OPTIONAL) ---
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- OpenAI-compatible model gateway (DeepSeek + Qwen) ---
# Default route: Vercel AI Gateway. AI_MODEL_GATEWAY_API_KEY is preferred;
# Vercel OIDC also works for the official Vercel endpoint in linked deployments.
# Custom OpenAI-compatible endpoints require an explicit gateway key and can be
# selected without changing product model IDs.
# Keep disabled until live response, tool-loop, privacy, and vision gates pass.
AI_MODEL_GATEWAY_ENABLED=0
AI_MODEL_GATEWAY_API_KEY=
AI_MODEL_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Vercel uses the registry slugs automatically. For a custom base URL, fill
# only the models that endpoint actually serves.
AI_GATEWAY_DEEPSEEK_V4_FLASH_MODEL=
AI_GATEWAY_DEEPSEEK_V4_PRO_MODEL=
AI_GATEWAY_QWEN37_PLUS_MODEL=
# Request-level provider allowlists. Add fallback slugs only after privacy,
# region, reliability, and price approval.
AI_GATEWAY_DEEPSEEK_PROVIDERS=deepseek
AI_GATEWAY_QWEN37_PLUS_PROVIDERS=alibaba

# Optional PDF model overrides. Values must be stable Papilab product IDs from
# the seven-model selector, never upstream provider slugs.
AI_PDF_EXTRACTION_MODEL=
AI_PDF_QUICK_EXTRACT_MODEL=
AI_PDF_DEEP_ANALYSIS_MODEL=

# --- AI Configuration (OPTIONAL — defaults shown) ---
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5.6-luna
AI_REASONING_MODEL=gpt-5.6-luna
AI_RATE_LIMIT=20
AI_DAILY_TOKEN_LIMIT=300000

# --- Agentic Modes (OPTIONAL) ---
# Scoping mode controls pre-protocol literature landscape exploration.
# Default behavior if unset: ENABLED.
# Set both flags to "0" to force-disable across client + server.
NEXT_PUBLIC_ENABLE_SCOPING_MODE=1
ENABLE_SCOPING_MODE=1

# Scoping decision card v2 controls the decision-first scoping artifact UI.
# Default behavior if unset: ENABLED.
NEXT_PUBLIC_SCOPING_DECISION_CARD_V2=1

# Chat study mentions v1 controls inline "Mentioned studies" chips and one-click add-to-ledger.
# Default behavior if unset: ENABLED.
NEXT_PUBLIC_CHAT_STUDY_MENTIONS_V1=1

# --- Mobile UX V2 Flags ---
# The certified viewport runtime defaults ON; route-specific flags remain OFF.
# Promotion order:
# 1) NEXT_PUBLIC_MOBILE_VP_V2
# 2) NEXT_PUBLIC_MOBILE_AI_V2
# 3) NEXT_PUBLIC_MOBILE_NOTES_V2
# 4) NEXT_PUBLIC_MOBILE_LEDGER_V2
# 5) NEXT_PUBLIC_MOBILE_DRAFT_V2
# 6) NEXT_PUBLIC_MOBILE_POPUP_V2
# 7) NEXT_PUBLIC_MOBILE_SCROLL_LOCK_V2
NEXT_PUBLIC_MOBILE_VP_V2=1
NEXT_PUBLIC_MOBILE_SCROLL_LOCK_V2=0
NEXT_PUBLIC_MOBILE_LEDGER_V2=0
NEXT_PUBLIC_MOBILE_NOTES_V2=0
NEXT_PUBLIC_MOBILE_DRAFT_V2=0
NEXT_PUBLIC_MOBILE_AI_V2=0
NEXT_PUBLIC_MOBILE_POPUP_V2=0

# --- Langfuse Observability (OPTIONAL) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com
