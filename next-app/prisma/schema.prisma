// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String
  isPlatformAdmin Boolean           @default(false)
  emailVerified   Boolean           @default(false)
  image           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  memberships     WorkspaceMember[]
  projects        Project[]         @relation("ProjectOwner")
  memories        UserMemory[]
  sessions        Session[]
  accounts        Account[]
  adminActions    AdminAuditLog[]   @relation("AdminAuditActor")
  adminTargets    AdminAuditLog[]   @relation("AdminAuditTarget")

  @@index([createdAt])
  @@index([isPlatformAdmin, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  targetUserId String
  action       String
  reason       String?
  requestId    String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  actor  User @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target User @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier, createdAt])
  @@index([expiresAt])
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  projects  Project[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("owner")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id             String   @id @default(cuid())
  workspaceId    String
  ownerId        String
  demoKey        String?
  name           String
  description    String?
  status         String
  statusText     String
  papers         Int?
  progress       Json?
  projectConversation Json? @map("projectCopilot")
  created        DateTime @default(now())
  modified       DateTime @updatedAt

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                  User                    @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  protocol               Protocol?
  draft                  Draft?
  studies                Study[]
  files                  FileAsset[]
  projectMemories        ProjectMemory[]
  studyMemories          StudyMemory[]
  studyProcessingJobs    StudyProcessingJob[]
  artifacts              Artifact[]
  notes                  Note[]
  draftVersions          DraftVersion[]
  draftCheckpoints       DraftCheckpoint[]
  aiConversations        AIConversation[]
  aiUsage                AIUsage[]
  agentRuns              AgentRun[]
  memoryRetrievals       MemoryRetrieval[]
  memoryEmbeddings       MemoryEmbedding[]
  autonomyConfigs        AutonomyConfig[]
  chatUnificationMetrics ChatUnificationMetric[]

  @@unique([ownerId, workspaceId, demoKey])
  @@index([workspaceId])
  @@index([ownerId])
}

model Protocol {
  id        String   @id @default(cuid())
  projectId String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Draft {
  id        String   @id @default(cuid())
  projectId String   @unique
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DraftVersion {
  id             String   @id @default(cuid())
  projectId      String
  section        String
  content        Json
  contentText    String?
  wordCount      Int      @default(0)
  artifactId     String?
  conversationId String?
  version        Int
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, section, version])
  @@index([projectId, section])
  @@index([projectId, createdAt])
}

model DraftCheckpoint {
  id             String    @id @default(cuid())
  projectId      String
  workspaceId    String?
  label          String?
  kind           String
  snapshot       Json
  fileAssetId    String?
  artifactId     String?
  conversationId String?
  createdAt      DateTime  @default(now())

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset?      @relation("DraftCheckpointFileAsset", fields: [fileAssetId], references: [id], onDelete: SetNull)
  artifact     Artifact?       @relation("DraftCheckpointArtifact", fields: [artifactId], references: [id], onDelete: SetNull)
  conversation AIConversation? @relation("DraftCheckpointConversation", fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([projectId, kind, createdAt])
  @@index([workspaceId])
  @@index([fileAssetId])
  @@index([artifactId])
  @@index([conversationId])
}

// Multi-user ready: workspaceId for explicit scoping (also derived via project)
model Study {
  id          String    @id @default(cuid())
  projectId   String
  workspaceId String? // Explicit workspace scope (denormalized for query efficiency)
  title       String
  authors     String
  year        Int
  status      String
  quality     String
  details     Json?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files          FileAsset[]
  memories       StudyMemory[]
  processingJobs StudyProcessingJob[]

  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([workspaceId])
}

// Multi-user ready: workspaceId for explicit scoping (also derived via project)
model FileAsset {
  id          String   @id @default(cuid())
  projectId   String
  workspaceId String? // Explicit workspace scope (denormalized for query efficiency)
  studyId     String?
  kind        String
  format      String?
  filename    String
  mimeType    String
  size        Int
  storagePath String
  publicUrl   String?
  version     Int      @default(1)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  study            Study?               @relation(fields: [studyId], references: [id], onDelete: Cascade)
  draftCheckpoints DraftCheckpoint[]    @relation("DraftCheckpointFileAsset")
  processingJobs   StudyProcessingJob[]

  @@index([projectId])
  @@index([workspaceId])
  @@index([studyId])
}

model StudyProcessingJob {
  id               String   @id @default(cuid())
  studyId          String
  projectId        String
  workspaceId      String?
  fileAssetId      String?
  phase            String
  state            String
  priority         String
  requestSource    String
  attemptCount     Int      @default(0)
  requestedAt      DateTime @default(now())
  startedAt        DateTime?
  leaseExpiresAt   DateTime?
  completedAt      DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  study     Study     @relation(fields: [studyId], references: [id], onDelete: Cascade)
  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@unique([studyId, phase])
  @@index([projectId, state, priority, requestedAt])
  @@index([leaseExpiresAt])
  @@index([studyId])
}

// AI Conversation - stores chat history for copilot and AI assistant
// Multi-user ready: userId + workspaceId for ownership scoping
model AIConversation {
  id          String               @id @default(cuid())
  userId      String? // Owner of the conversation (required for multi-user)
  workspaceId String? // Workspace scope (required for multi-user)
  title       String? // Auto-generated or user-edited title
  context     String // "global" | "project" | "study"
  page        String? // "ledger" | "protocol" | "draft" | "study" | "ai"
  projectId   String?
  studyId     String?
  archived    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  messages    AIMessage[]
  summary     ConversationSummary?
  usage       AIUsage[]
  draftCheckpoints DraftCheckpoint[] @relation("DraftCheckpointConversation")
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, context])
  @@index([userId, projectId])
  @@index([workspaceId])
  @@index([workspaceId, context])
  @@index([projectId])
  @@index([studyId])
  @@index([context])
}

// AI Message - individual messages in a conversation
model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "system" | "user" | "assistant" | "tool"
  content        String
  toolCalls      Json?
  toolResultId   String? // For tool role messages: maps to the tool_call_id
  attachments    Json? // [{fileAssetId, filename, mimeType, size, isExisting}]
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt, id])
}

// AI Usage - tracks token usage for rate limiting and cost control
// Multi-user ready: userId + workspaceId for per-user/workspace tracking
model AIUsage {
  id             String          @id @default(cuid())
  userId         String? // User who made the request (required for multi-user)
  workspaceId    String? // Workspace for billing/limits (required for multi-user)
  projectId      String? // Optional: specific project context
  conversationId String?
  source         String          @default("legacy_unknown")
  contextPage    String          @default("legacy_unknown")
  model                    String // Provider-observed model when available
  provider                 String? // Provider-observed upstream when available; null when unknown
  requestedModel           String?
  requestedProvider        String?
  requestedReasoningEffort String?
  requestedDeliveryMode    String?
  actualReasoningEffort    String?
  actualDeliveryMode       String?
  inputTokens              Int
  cachedInputTokens        Int             @default(0)
  cacheWriteInputTokens    Int             @default(0)
  outputTokens             Int
  reasoningTokens          Int             @default(0)
  estimatedCostUsd         Float?
  createdAt      DateTime        @default(now())
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([source, createdAt])
  @@index([contextPage, createdAt])
}

// ============================================================================
// AI MEMORY SYSTEM
// Structured knowledge storage (distinct from conversation transcripts)
// Based on MEMORY_LESSONS.md principles
// ============================================================================

// User Memory - user-level preferences and styles
model UserMemory {
  id     String @id @default(cuid())
  userId String

  // Memory content
  type      String // "preference" | "style" | "workflow"
  key       String // e.g., "citation_style", "writing_tone"
  value     String // e.g., "APA 7th", "concise_technical"
  rationale String? // Why this preference was set

  // Lifecycle
  status             String    @default("active") // "active" | "archived"
  source             String    @default("explicit_user") // "explicit_user" | "conversation_extraction" | "artifact_accept" | "system_sync" | "legacy"
  authority          String    @default("confirmed") // "canonical" | "confirmed" | "inferred" | "proposed"
  polarity           String    @default("affirming") // "affirming" | "rejecting" | "neutral"
  sourceRefType      String?
  sourceRefId        String?
  confidence         Float     @default(1)
  retrievalCount     Int       @default(0)
  usedInAnswerCount  Int       @default(0)
  acceptedCount      Int       @default(0)
  rejectedCount      Int       @default(0)
  contradictionCount Int       @default(0)
  pinned             Boolean   @default(false)
  embeddingStatus    String    @default("pending") // "pending" | "ready" | "failed"
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  // For retrieval
  tags String[] @default([])

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, pinned])
  @@index([userId, authority, status])
  @@index([userId, embeddingStatus])
}

// Project Memory - project-level goals, criteria, and decisions
model ProjectMemory {
  id        String @id @default(cuid())
  projectId String

  // Memory content
  type      String // "decision" | "definition" | "criterion" | "goal"
  key       String?
  category  String? // "inclusion" | "exclusion" | "outcome" | "population"
  statement String // The actual memory content
  rationale String? // Why this decision was made
  context   String? // Additional context or notes

  // Lifecycle
  status             String    @default("active") // "active" | "revised" | "archived"
  source             String    @default("explicit_user") // "explicit_user" | "protocol_sync" | "artifact_accept" | "conversation_extraction" | "system_sync" | "legacy"
  authority          String    @default("confirmed") // "canonical" | "confirmed" | "inferred" | "proposed"
  polarity           String    @default("affirming") // "affirming" | "rejecting" | "neutral"
  sourceRefType      String?
  sourceRefId        String?
  confidence         Float     @default(1)
  retrievalCount     Int       @default(0)
  usedInAnswerCount  Int       @default(0)
  acceptedCount      Int       @default(0)
  rejectedCount      Int       @default(0)
  contradictionCount Int       @default(0)
  pinned             Boolean   @default(false)
  embeddingStatus    String    @default("pending") // "pending" | "ready" | "failed"
  lastUsedAt         DateTime?
  version            Int       @default(1)
  supersededBy       String? // ID of newer version
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  // For retrieval
  tags           String[] @default([])
  importance     String   @default("normal") // "critical" | "important" | "normal"
  importanceRank Int      @default(10)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, type])
  @@index([projectId, importance])
  @@index([projectId, importanceRank])
  @@index([projectId, pinned])
  @@index([projectId, key])
  @@index([projectId, authority, status])
  @@index([projectId, source])
  @@index([projectId, embeddingStatus])
}

// Study Memory - study-level facts and summaries
model StudyMemory {
  id        String @id @default(cuid())
  studyId   String
  projectId String

  // Memory content
  type       String // "summary" | "finding" | "limitation" | "quality"
  key        String?
  category   String? // "methods" | "results" | "bias" | "population"
  content    String // The extracted/generated content
  source     String? // "deep_analysis" | "artifact_accept" | "explicit_user" | "ai_generated" | "extracted" | "legacy"
  authority  String  @default("inferred") // "canonical" | "confirmed" | "inferred" | "proposed"
  polarity   String  @default("affirming") // "affirming" | "rejecting" | "neutral"
  sourceRefType String?
  sourceRefId   String?
  locator    Json?
  confidence Float? // AI confidence score (0-1)

  // Lifecycle
  status             String   @default("active")
  retrievalCount     Int      @default(0)
  usedInAnswerCount  Int      @default(0)
  acceptedCount      Int      @default(0)
  rejectedCount      Int      @default(0)
  contradictionCount Int      @default(0)
  pinned             Boolean  @default(false)
  embeddingStatus    String   @default("pending") // "pending" | "ready" | "failed"
  lastUsedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  archivedAt         DateTime?

  // For retrieval
  tags String[] @default([])

  // Relations
  study   Study   @relation(fields: [studyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([studyId, type])
  @@index([projectId, type])
  @@index([studyId, status])
  @@index([projectId, pinned])
  @@index([projectId, key])
  @@index([projectId, authority, status])
  @@index([projectId, source])
  @@index([projectId, embeddingStatus])
}

// Conversation Summary - compressed context for long conversations
model ConversationSummary {
  id             String @id @default(cuid())
  conversationId String @unique

  // Summary content
  summary        String // Compressed summary of conversation
  keyPoints      String[] @default([])
  decisions      String[] @default([])
  followUpNeeded String[] @default([])

  // Metadata
  messageCount     Int // Number of messages summarized
  lastSummarizedAt DateTime // When this was last updated
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Memory Retrieval Log - audit trail for memory access
model MemoryRetrieval {
  id             String  @id @default(cuid())
  conversationId String?

  // What was retrieved
  query       String // What the AI was trying to remember
  memoryType  String // "user" | "project" | "study"
  memoryIds   String[] @default([])
  resultCount Int

  // Context
  userId    String?
  projectId String?
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     MemoryRetrievalItem[]

  @@index([conversationId])
  @@index([projectId])
  @@index([createdAt])
}

model MemoryRetrievalItem {
  id            String   @id @default(cuid())
  retrievalId   String
  memoryType    String // "user" | "project" | "study"
  memoryId      String
  rank          Int
  finalScore    Float
  lexicalScore  Float?
  semanticScore Float?
  deterministic Boolean  @default(false)
  tokenEstimate Int
  source        String?
  authority     String?
  usedInAnswer  Boolean  @default(false)
  createdAt     DateTime @default(now())

  retrieval MemoryRetrieval @relation(fields: [retrievalId], references: [id], onDelete: Cascade)

  @@index([retrievalId])
  @@index([memoryType, memoryId])
  @@index([source])
  @@index([authority])
}

// Semantic embedding index for hybrid memory retrieval (pgvector-backed)
model MemoryEmbedding {
  id          String                @id @default(cuid())
  memoryType  String // "user" | "project" | "study"
  memoryId    String
  userId      String?
  projectId   String?
  studyId     String?
  model       String
  contentHash String
  sourceText  String
  embedding   Unsupported("vector")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  project     Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([memoryType, memoryId, model])
  @@index([projectId, memoryType])
  @@index([userId, memoryType])
  @@index([studyId, memoryType])
}

// ============================================================================
// AGENT RUN SYSTEM
// Event-sourced agent lifecycle (AgentRun = trace, RunEvent = span)
// See planC Phase 0.2
// ============================================================================

model AgentRun {
  id                        String    @id @default(cuid())
  projectId                 String?
  conversationId            String?
  userId                    String?
  parentRunId               String?
  rootRunId                 String?
  trigger                   String // "user_message" | "proactive" | "event"
  agentMode                 String // "protocol" | "search" | "screening" | "drafting" | "qa" | "general"
  status                    String // "running" | "completed" | "failed" | "cancelled" | "paused"
  model                     String? // Requested product model ID
  provider                  String? // Requested provider route
  reasoningEffort           String?
  deliveryMode              String?
  actualModel               String?
  actualProvider            String?
  actualReasoningEffort     String?
  actualDeliveryMode        String?
  costTokensIn              Int       @default(0)
  costTokensOut             Int       @default(0)
  startedAt                 DateTime  @default(now())
  runPhase                  String    @default("plan") // "plan" | "ask" | "act" | "verify" | "finalize"
  phaseEnteredAt            DateTime  @default(now())
  lastActivityAt            DateTime  @default(now())
  lastDurableProgressAt     DateTime  @default(now())
  durabilityState           String    @default("durable") // "durable" | "degraded"
  durabilityDegradedReason  String?
  finalizationState         String    @default("not_started") // "not_started" | "in_progress" | "completed" | "failed"
  abnormalEndClassification String?
  completedAt               DateTime?

  project     Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      AgentRun?       @relation("AgentRunLineage", fields: [parentRunId], references: [id], onDelete: SetNull)
  children    AgentRun[]      @relation("AgentRunLineage")
  events      RunEvent[]
  checkpoints RunCheckpoint[]
  toolIdempotencyRecords ToolIdempotencyRecord[]
  decisionRequests DecisionRequestRecord[]
  artifacts   Artifact[]

  @@index([projectId, startedAt])
  @@index([conversationId])
  @@index([conversationId, startedAt])
  @@index([conversationId, lastActivityAt])
  @@index([conversationId, lastDurableProgressAt])
  @@index([userId])
  @@index([parentRunId, startedAt])
  @@index([rootRunId, startedAt])
}

model RunEvent {
  id          String   @id @default(cuid())
  runId       String
  sequence    Int
  type        String // "message" | "tool_call" | "tool_result" | "artifact_proposed" |
  //  "artifact_reviewed" | "memory_retrieval" | "context_assembly" |
  //  "plan_proposed" | "plan_approved" | "checkpoint" | "error"
  payload     Json
  toolName    String?
  artifactId  String?
  messageRole String?
  tokensIn    Int?
  tokensOut   Int?
  errorCode   String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, sequence])
  @@index([runId, type])
  @@index([artifactId])
}

model RunCheckpoint {
  id                  String   @id @default(cuid())
  runId               String
  conversationId      String
  kind                String // "tool_result_ready" | "artifact_ready"
  status              String   @default("ready") // "ready" | "invalidated"
  nextStep            String // "reason_from_tool_result" | "reason_from_artifact_state"
  seedVersion         Int      @default(1)
  seed                Json
  sourceEventSequence Int
  sourceArtifactId    String?
  invalidatedReason   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sourceEventSequence])
  @@index([runId, status, sourceEventSequence(sort: Desc)])
  @@index([conversationId, status, sourceEventSequence(sort: Desc)])
  @@index([sourceArtifactId])
}

model ToolIdempotencyRecord {
  id          String    @id @default(cuid())
  scopeKey    String
  toolName    String
  fingerprint String
  status      String    @default("running") // "running" | "completed"
  callId      String?
  runId       String?
  projectId   String?
  userId      String?
  studyId     String?
  result      Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  run AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, toolName, fingerprint])
  @@index([scopeKey, createdAt])
  @@index([runId])
  @@index([projectId])
  @@index([userId])
}

model DecisionRequestRecord {
  id                  String    @id @default(cuid())
  callId              String
  sourceRunId         String
  rootRunId           String?
  conversationId      String?
  projectId           String?
  userId              String?
  studyId             String?
  decisionBoundaryKey String
  status              String    @default("pending") // "pending" | "answered" | "accepted_recommended" | "cancelled" | "superseded" | "interrupted" | "stale" | "expired"
  request             Json
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  run        AgentRun                  @relation(fields: [sourceRunId], references: [id], onDelete: Cascade)
  resolution DecisionResolutionRecord?

  @@unique([sourceRunId, callId])
  @@index([conversationId, status, createdAt])
  @@index([rootRunId, createdAt])
  @@index([projectId, status, createdAt])
  @@index([decisionBoundaryKey, status])
}

model DecisionResolutionRecord {
  id             String   @id @default(cuid())
  requestId      String   @unique
  callId         String
  sourceRunId    String
  resolutionKind String
  resolution     Json
  userId         String?
  createdAt      DateTime @default(now())

  request DecisionRequestRecord @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([sourceRunId, createdAt])
  @@index([callId])
}

model ChatUnificationMetric {
  id              String    @id @default(cuid())
  eventId         String    @unique
  version         Int       @default(1)
  type            String
  surface         String
  userId          String?
  workspaceId     String?
  projectId       String?
  runId           String?
  conversationId  String?
  payload         Json
  clientTimestamp DateTime?
  recordedAt      DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([recordedAt])
  @@index([type, recordedAt])
  @@index([surface, recordedAt])
  @@index([workspaceId, recordedAt])
  @@index([runId, recordedAt])
  @@index([conversationId, recordedAt])
  @@index([projectId, recordedAt])
}

model Artifact {
  id              String    @id @default(cuid())
  runId           String
  projectId       String?
  conversationId  String?
  userId          String?
  type            String // "study_proposal" | "draft_diff" | "screening_batch" |
  //  "protocol_suggestion" | "criteria_card" | "evidence_table" |
  //  "plan" | "memory_proposal"
  status          String // "proposed" | "accepted" | "rejected" | "edited" |
  //  "auto_applied" | "expired" | "collapsed"
  title           String
  payload         Json
  snapshot        Json?
  version         Int       @default(1)
  sourceEventId   String?
  applyId         String?   @unique
  appliedAt       DateTime?
  appliedByUserId String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())

  run              AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draftCheckpoints DraftCheckpoint[]  @relation("DraftCheckpointArtifact")

  @@index([runId])
  @@index([projectId, status])
  @@index([conversationId])
  @@index([type, status])
}

model AutonomyConfig {
  id            String   @id @default(cuid())
  userId        String?
  projectId     String?
  preset        String // "manual" | "assisted" | "autonomous" | "custom"
  toolOverrides Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Note {
  id                   String    @id @default(cuid())
  projectId            String
  userId               String?
  title                String?
  content              Json
  contentText          String?
  tags                 String[]  @default([])
  linkedStudyId        String?
  linkedSection        String?
  source               String    @default("manual") // "manual" | "conversation"
  sourceConversationId String?
  sourceMessageId      String?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([projectId, source])
}
