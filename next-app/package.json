{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "./scripts/migrate-if-prod.sh && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint && npm run check:theme-primitives",
    "lint:governance": "eslint -c eslint-governance.config.mjs app components contexts hooks lib scripts",
    "lint:governance:phase1": "eslint -c eslint-governance-phase1.config.mjs app components contexts hooks lib scripts",
    "lint:governance:phase2-hotspots": "eslint -c eslint-governance-phase2-hotspots.config.mjs app/ai components/chat components/project/ConversationMainView.tsx components/project/ProjectCopilotPanel.tsx components/project/ProjectConversationComposer.tsx components/project/ProjectConversationAutonomySettings.tsx components/project/project-copilot-panel-scroll-containment.ts contexts/ProjectConversationContext.tsx hooks/useProjectConversationManager.ts hooks/useProjectConversationStreamActions.ts app/project/[id]/layout.tsx",
    "lint:governance:phase3-searchability": "eslint -c eslint-governance-phase3-searchability.config.mjs app components contexts hooks",
    "lint:governance:phase4-async": "eslint -c eslint-governance-phase4-async.config.mjs app components contexts hooks",
    "lint:governance:phase4-tests": "eslint -c eslint-governance-phase4-tests.config.mjs lib/agent lib/server/agent lib/server/ai/tools",
    "lint:governance:phase4-policy": "npm run lint:governance:phase4-async && npm run lint:governance:phase4-tests",
    "lint:governance:logging": "eslint -c eslint-governance-logging.config.mjs lib/server app/actions app/api",
    "lint:governance:audit": "node scripts/lint-governance-audit.mjs",
    "lint:styles": "stylelint \"**/*.css\" --cache --cache-location .stylelintcache",
    "check:theme-primitives": "bash scripts/check-no-literal-rgb-primitives.sh",
    "check:runtime-test-impact": "node scripts/check-runtime-test-impact.mjs",
    "check:chat-stream-architecture": "node scripts/check-chat-stream-architecture.mjs --mode=enforce",
    "check:agent-quality": "tsx scripts/check-agent-quality-gate.ts",
    "check:pr": "npm run typecheck && npm run test:governance && npm run check:chat-stream-architecture && npm run check:agent-quality && npm run test:vitest && npm run build",
    "test": "vitest",
    "test:vitest": "vitest run",
    "test:eslint-rules": "vitest run eslint/rules/**/*.test.ts",
    "test:governance-tooling": "vitest run scripts/__tests__/check-runtime-test-impact.test.ts scripts/__tests__/eslint-governance-config.test.ts scripts/__tests__/eslint-governance-logging-config.test.ts scripts/__tests__/eslint-governance-phase1-config.test.ts scripts/__tests__/eslint-governance-phase2-hotspots-config.test.ts scripts/__tests__/eslint-governance-phase3-searchability-config.test.ts scripts/__tests__/eslint-governance-phase4-async-config.test.ts scripts/__tests__/eslint-governance-phase4-tests-config.test.ts scripts/__tests__/github-workflows.test.ts scripts/__tests__/governance-ci-contract.test.ts scripts/__tests__/lint-governance-audit.test.ts",
    "test:run": "vitest run",
    "test:governance": "npm run governance:ci-required",
    "test:governance:informational": "npm run governance:ci-informational",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test",
    "test:e2e:foundation": "playwright test --project=mobile-chromium --workers=2 mobile-home-foundation.spec.ts mobile-auth-foundation.spec.ts mobile-project-shell-foundation.spec.ts mobile-protocol-foundation.spec.ts mobile-ai-entry-smoke.spec.ts",
    "test:e2e:mobile": "playwright test --project=mobile-chromium --workers=1",
    "test:e2e:mobile:foundation": "playwright test --project=mobile-chromium --workers=2 mobile-home-foundation.spec.ts mobile-auth-foundation.spec.ts mobile-project-shell-foundation.spec.ts mobile-protocol-foundation.spec.ts mobile-ai-entry-smoke.spec.ts",
    "test:e2e:mobile:smoke": "playwright test --project=mobile-chromium --workers=1 mobile-home-entry-smoke.spec.ts mobile-login-smoke.spec.ts",
    "db:doctor": "bash scripts/db-doctor.sh",
    "db:repair-run-events": "node scripts/repair-run-event-sequences.mjs",
    "db:migrate:safe": "bash scripts/migrate-deploy-safe.sh",
    "db:release-gate": "bash scripts/release-gate-prod.sh",
    "db:ops": "bash scripts/db-ops.sh",
    "admin:bootstrap": "tsx scripts/bootstrap-platform-admin.ts",
    "chat:burnin:validate": "tsx scripts/validate-chat-unification-burn-in.ts",
    "memory:warmup": "tsx scripts/warmup-memory-embeddings.ts",
    "memory:validate": "tsx scripts/validate-memory-rollout.ts",
    "governance:check": "node scripts/check-governance-docs.mjs --mode=${GOVERNANCE_CHECK_MODE:-enforce}",
    "governance:ci-required": "npm run governance:check && npm run lint && npm run test:eslint-rules && npm run test:governance-tooling && npm run lint:governance:phase1 && npm run lint:governance:phase2-hotspots && npm run lint:governance:phase3-searchability && npm run lint:governance:phase4-policy && npm run lint:governance:logging && npm run check:runtime-test-impact",
    "governance:ci-informational": "npm run lint:governance && npm run lint:governance:audit > governance-audit.json",
    "citation:report": "tsx scripts/report-citation-preview-metrics.ts",
    "citation:smoke": "NODE_OPTIONS='--conditions=react-server' tsx scripts/smoke-citation-providers.ts",
    "citation:diagnose": "tsx scripts/diagnose-citation-url.ts",
    "test:smoke:citation": "NODE_OPTIONS='--conditions=react-server' RUN_CITATION_PROVIDER_TESTS=1 tsx scripts/smoke-citation-providers.ts",
    "test:smoke:mobile": "playwright test --project=mobile-chromium --workers=1 mobile-home-entry-smoke.spec.ts mobile-login-smoke.spec.ts",
    "draft:benchmark:generate-docx": "tsx scripts/draft-benchmark/generate-docx-import-fixture.ts",
    "draft:benchmark:report": "tsx scripts/draft-benchmark/report-fixture-summary.ts",
    "draft:benchmark:check": "tsx scripts/draft-benchmark/check-acceptance.ts",
    "perf:budget-check": "node scripts/perf-budget-check.mjs",
    "perf:generate-results": "tsx scripts/generate-perf-results.ts",
    "perf:baseline-report": "node scripts/perf-baseline-report.mjs",
    "perf:ai-bundle-report": "tsx scripts/report-ai-bundle.ts",
    "perf:ai-closeout-capture": "tsx scripts/capture-ai-closeout.ts",
    "perf:ai-closeout-compare": "tsx scripts/compare-ai-closeout.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@langfuse/otel": "^4.6.0",
    "@langfuse/tracing": "^4.6.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tiptap/core": "^3.17.1",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-underline": "^3.17.1",
    "@tiptap/react": "^3.17.1",
    "@tiptap/starter-kit": "^3.17.1",
    "better-auth": "^1.4.19",
    "better-call": "^1.1.8",
    "citation-js": "^0.7.22",
    "cmdk": "^1.1.1",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.4",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "node-html-parser": "^7.1.0",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.17.2",
    "prisma": "^7.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.2",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  }
}
