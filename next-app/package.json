{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "./scripts/migrate-if-prod.sh && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint && npm run check:theme-primitives",
    "lint:styles": "stylelint \"**/*.css\" --cache --cache-location .stylelintcache",
    "check:theme-primitives": "bash scripts/check-no-literal-rgb-primitives.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "db:doctor": "bash scripts/db-doctor.sh",
    "db:repair-run-events": "node scripts/repair-run-event-sequences.mjs",
    "db:migrate:safe": "bash scripts/migrate-deploy-safe.sh",
    "db:release-gate": "bash scripts/release-gate-prod.sh",
    "db:ops": "bash scripts/db-ops.sh",
    "admin:bootstrap": "tsx scripts/bootstrap-platform-admin.ts",
    "chat:burnin:validate": "tsx scripts/validate-chat-unification-burn-in.ts",
    "memory:warmup": "tsx scripts/warmup-memory-embeddings.ts",
    "memory:validate": "tsx scripts/validate-memory-rollout.ts",
    "perf:budget-check": "node scripts/perf-budget-check.mjs",
    "perf:generate-results": "tsx scripts/generate-perf-results.ts",
    "perf:baseline-report": "node scripts/perf-baseline-report.mjs",
    "perf:ai-bundle-report": "tsx scripts/report-ai-bundle.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@langfuse/otel": "^4.6.0",
    "@langfuse/tracing": "^4.6.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tiptap/extension-placeholder": "^3.17.1",
    "@tiptap/extension-underline": "^3.17.1",
    "@tiptap/react": "^3.17.1",
    "@tiptap/starter-kit": "^3.17.1",
    "better-auth": "^1.4.19",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.4",
    "next": "16.1.4",
    "openai": "^6.17.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.17.2",
    "prisma": "^7.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "jsdom": "^28.0.0",
    "stylelint": "^17.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0"
  }
}
